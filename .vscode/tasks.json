{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: g++.exe build active file",
      "command": "C:/mingw64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-g",
        "${fileDirname}/battleship_menu.cpp",
        "-o",
        "${fileDirname}/battleship_menu.exe",
        "-I",
        "C:/libraries/SFML-3.1.0/include",
        "-L",
        "C:/libraries/SFML-3.1.0/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system",
        "-lsfml-audio"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compiler: C:/mingw64/bin/g++.exe"
    }
  ]
}
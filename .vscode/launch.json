{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Battleship",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/battleship_menu.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/libraries/SFML-3.1.0/bin;C:/mingw64/bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: g++.exe build active file"
    }
  ]
}